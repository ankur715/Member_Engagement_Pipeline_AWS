# Copy to .env and fill in. .env is gitignored -- never commit real values.

# --- AWS (credentials come from `aws configure` / AWS_PROFILE, not this file) ---
AWS_REGION=us-east-1
AWS_PROFILE=member-engagement
S3_BUCKET=                      # terraform output: s3_bucket

# --- Redshift Serverless ---
REDSHIFT_HOST=                  # terraform output: redshift_endpoint
REDSHIFT_PORT=5439
REDSHIFT_DB=engagement
REDSHIFT_USER=admin
REDSHIFT_PASSWORD=
REDSHIFT_IAM_ROLE_ARN=          # terraform output: redshift_copy_role_arn

# --- PHI handling ---
# HMAC key for member tokenization:  python -c "import secrets; print(secrets.token_hex(32))"
PHI_HASH_KEY=

# --- Mock external services (FastAPI, see mock_api/) ---
MOCK_API_URL=http://localhost:9000
MOCK_API_TOKEN=local-dev-token

# --- Salesforce (optional). Blank = use the mock Salesforce REST API. ---
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=
SF_DOMAIN=login

# --- Google Sheets (optional). Blank = use the mock Sheets API. ---
GOOGLE_SERVICE_ACCOUNT_JSON=    # path to a service-account key file
GOOGLE_DNC_SHEET_ID=            # input: ops team's do-not-contact tracker
GOOGLE_KPI_SHEET_ID=            # output: per-plan KPI report for account managers

ALERT_EMAIL=

# --- Public data (optional). Blank = the offline mock. Real hosts: ---
# NYC_OPEN_DATA_URL=https://data.cityofnewyork.us
# NYC_OPEN_DATA_APP_TOKEN=        # optional Socrata app token (higher rate limits)
# NWS_API_URL=https://api.weather.gov
# NWS_USER_AGENT=member-engagement-pipeline (you@example.com)

# --- LLM utilities (optional). none | anthropic | bedrock ---
# anthropic: set ANTHROPIC_API_KEY (or log in with the `ant` CLI)
# bedrock:   uses your AWS credentials; enable Claude model access in the Bedrock console first
LLM_PROVIDER=none
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
LLM_MAX_NOTES_PER_RUN=100
SYNTHETIC_DATA=true
